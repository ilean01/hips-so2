[Unit]
Description=HIPS - deteccion y prevencion automatica
After=network.target postgresql.service

[Service]
Type=oneshot
WorkingDirectory=/opt/hips-so2
EnvironmentFile=/etc/hips/hips.env
ExecStart=/usr/bin/python3 /opt/hips-so2/hips.py --guardar-db --enviar-email --prevenir --json
User=root
Group=root
