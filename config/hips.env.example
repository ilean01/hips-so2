# Archivo de configuración de entorno para HIPS
# Copiar este archivo como /etc/hips/hips.env y completar las contraseñas reales.

HIPS_DB_NAME=hips_db
HIPS_DB_USER=hips_app
HIPS_DB_PASSWORD=CAMBIAR_ESTA_CONTRASENA
HIPS_DB_HOST=127.0.0.1
HIPS_DB_PORT=5432
PYTHONPATH=/opt/hips-so2

# Correo del administrador para recibir alertas
HIPS_ADMIN_EMAIL=admin@localhost
HIPS_SENDMAIL_PATH=/usr/sbin/sendmail

# Dashboard web
HIPS_WEB_USER=admin
HIPS_WEB_PASSWORD=CAMBIAR_ESTA_CONTRASENA_WEB
HIPS_WEB_SECRET_KEY=CAMBIAR_ESTA_CLAVE_SECRETA
